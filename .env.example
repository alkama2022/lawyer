# ------------------------------------------------------------------
# Lexfolio — environment configuration
# Copy this file to `.env` and adjust values for your environment.
# `.env` is git-ignored; never commit real secrets.
# Only variables prefixed with VITE_ are exposed to the browser.
# ------------------------------------------------------------------

# Base URL for the backend API. Same-origin by default.
# Set to the full backend origin (e.g. https://api.example.com) when the
# API is hosted separately.
VITE_API_BASE_URL=/api

# Demo credentials used by the mock authentication layer.
# Replace the mock auth (src/lib/auth.tsx) with a real auth backend and
# remove these before production use.
VITE_DEMO_EMAIL=a.musa@haldane-partners.law
VITE_DEMO_PASSWORD=Chambers2026

# Server-side (nitro) configuration — set in the deployment environment.
# PORT=3000
# NITRO_HOST=0.0.0.0
